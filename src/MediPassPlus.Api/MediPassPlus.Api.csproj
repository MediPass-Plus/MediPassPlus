<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ddf53eee-6997-4efa-ad1c-9c54fafb636c</UserSecretsId>
    <!-- XML documentation is folded into the Swagger document by Swashbuckle (ADR-0012).
         CS1591 stays suppressed: documenting every public member is not required, only the API surface. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared input validation and the single error envelope (ADR-0010, NFR-SEC-06, NFR-REL-04). -->
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediPassPlus.Application\MediPassPlus.Application.csproj" />
    <ProjectReference Include="..\MediPassPlus.Infrastructure\MediPassPlus.Infrastructure.csproj" />
  </ItemGroup>

</Project>
