{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Jwt": {
    "Issuer": "MediPassPlus",
    "Audience": "MediPassPlus.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SessionDays": 30
  }
} 
