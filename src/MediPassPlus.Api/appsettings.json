{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "ExposeOutsideDevelopment": false
  },
  "RateLimiting": {
    "QrApprove": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    }
  }
}
