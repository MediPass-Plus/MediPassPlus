{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "ExposeOutsideDevelopment": false
  },
  "RateLimiting": {
    "QrApprove": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "CodeGeneration": {
      "PermitLimit": 3,
      "WindowMinutes": 15
    },
    "CodeVerification": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    },
    "ChangePassword": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    }
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "FromAddress": "no-reply@medipass.local",
    "FromName": "MediPass+"
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:4200"
  }
}
